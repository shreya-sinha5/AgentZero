# AgentZero Environment Configuration

# Service Ports
BACKEND_PORT=8000
MONITORED_APP_PORT=8001
PROMETHEUS_PORT=9090

# Database
DATABASE_URL=sqlite:///./agentzero.db

# Telemetry
PROMETHEUS_URL=http://localhost:9090

# LLM Provider (Provider-agnostic interface)
# Options: openai, anthropic, ollama, mock
LLM_PROVIDER=mock
LLM_MODEL=gpt-4o
LLM_API_KEY=your-api-key-here
LLM_API_BASE=https://api.openai.com/v1

# Runtime Limits
MAX_RETRIES_PER_NODE=3
INVESTIGATION_TIMEOUT_SECONDS=300
SANDBOX_TIMEOUT_SECONDS=120
